FROM python:3.11-slim

# Optional build arg for Google Analytics ID
ARG GA_ID=GA_ID_PLACEHOLDER

# Suppress debconf warnings in Docker
ENV DEBIAN_FRONTEND=noninteractive \
    DEBCONF_NONINTERACTIVE_SEEN=true

WORKDIR /app

# Install system dependencies including X11 libs for RDKit drawing
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libxrender1 \
    libxext6 \
    libexpat1 \
    libfontconfig1 \
    libfreetype6 \
    && rm -rf /var/lib/apt/lists/*

# Copy configuration
COPY pyproject.toml .

# Install python dependencies including the 'web' extras
# We install in editable mode so changes in the volume are reflected
# We need to copy the directory structure for pip to be happy finding 'healer' package
# during install, even if empty initially, but here we copy everything.
COPY . .

# Replace GA ID placeholder if provided
RUN if [ "$GA_ID" != "GA_ID_PLACEHOLDER" ]; then \
      sed -i "s/GA_ID_PLACEHOLDER/$GA_ID/g" healer/web/static/index.html; \
    fi

RUN pip install --no-cache-dir -e ".[web]"

# The command is overridden by docker-compose
CMD ["uvicorn", "healer.web.app:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "8"]

